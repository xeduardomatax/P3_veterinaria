<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>mx.tecnm.orizaba.tp</groupId>
  <artifactId>veterinaria</artifactId>
  <version>1.0.0</version>
  <name>Miniproyecto 3 - Control de Atenciones de una Clínica Veterinaria</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>mx.tecnm.orizaba.tp.veterinaria.app.PruebasModelo</exec.mainClass>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>3.5.4</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration><compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs></configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration><mainClass>${exec.mainClass}</mainClass></configuration>
        <executions>
          <execution>
            <id>restauracion-atomica</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration>
              <mainClass>mx.tecnm.orizaba.tp.veterinaria.app.PruebaRestauracionAtomica</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>aceptacion-modelo</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>mx.tecnm.orizaba.tp.veterinaria.app.PruebasModelo</mainClass></configuration>
          </execution>
          <execution>
            <id>integracion</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration><mainClass>mx.tecnm.orizaba.tp.veterinaria.app.PruebasIntegracion</mainClass></configuration>
          </execution>
          <execution>
            <id>validaciones-clave</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration>
              <mainClass>mx.tecnm.orizaba.tp.veterinaria.app.PruebaValidaciones</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>reinicio-tarea</id><phase>test</phase><goals><goal>java</goal></goals>
            <configuration>
              <mainClass>mx.tecnm.orizaba.tp.veterinaria.app.PruebaReinicioTarea</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <filters><filter><artifact>*:*</artifact><excludes>
              <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
              <exclude>META-INF/MANIFEST.MF</exclude><exclude>module-info.class</exclude>
              <exclude>META-INF/versions/*/module-info.class</exclude>
            </excludes></filter></filters>
            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                <mainClass>mx.tecnm.orizaba.tp.veterinaria.app.Aplicacion</mainClass>
              </transformer>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
            </transformers>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>escritorio</id>
      <properties><exec.mainClass>mx.tecnm.orizaba.tp.veterinaria.app.Aplicacion</exec.mainClass></properties>
    </profile>
    <profile>
      <id>demo</id>
      <properties><exec.mainClass>mx.tecnm.orizaba.tp.veterinaria.app.DemoModelo</exec.mainClass></properties>
    </profile>
  </profiles>
</project>
