digraph Arquitectura {
  graph [rankdir=TB, splines=true, nodesep=0.7, ranksep=0.9, fontname="Arial", fontsize=20, labelloc=t, label="Arquitectura de escritorio - Clínica veterinaria\nDependencias del código actual · 17/10/2026", bgcolor=white, pad=0.3];
  node [shape=box, style="rounded,filled", fillcolor="#edf3f7", color="#527080", fontname="Arial", fontsize=12, margin="0.18,0.13"];
  edge [fontname="Arial", fontsize=10, color="#527080", arrowsize=0.8];
  app [label="app\nAplicacion · DemoModelo\nPruebasModelo · PruebasIntegracion\nDatosEjemplo", fillcolor="#e1eaf8"];
  ui [label="ui · Swing + FlatLaf\nVentanaClinica\nProcedimientos · Propietarios · Atenciones\nReportes · Bitácora\nSwingWorker + ejecutor de un hilo", fillcolor="#e1eaf8"];
  servicio [label="servicio · Clinica\nCRUD y estados · validaciones de casos de uso\nRespaldo / restauración del catálogo\nIngresos · particiones · tarifas · top N\nMonitorSeguimiento (clase interna)\nabrirArchivo / close administran la conexión", fillcolor="#fff0c9"];
  persistencia [label="persistencia\nRepositorio<T,K> + MapeadorFila<R>\nRepositorioProcedimientoSQLite\nRepositorioPropietarioSQLite\nRepositorioAtencionSQLite\nConexionSQLite · Respaldo", fillcolor="#e4f0e7"];
  concurrencia [label="concurrencia\nTareaPeriodica implements Runnable\nvolatile · interrupt · join", fillcolor="#f4e5ef"];
  eventos [label="eventos\nEvento · TipoEvento\nOyenteEvento\nNotificación del monitor → invokeLater en UI", fillcolor="#f4e5ef"];
  funcional [label="funcional\nRegla<T> · Reglas\nFabricaElemento<E,A>", fillcolor="#ede8f5"];
  modelo [label="modelo\nFacturable · Procedimiento y subtipos\nPropietario · Atencion.Linea\nCatalogoProcedimientos · CodigoClinico\nEstado · Nivel · capacidades", fillcolor="#e0f0f3"];
  sqlite [shape=cylinder, label="datos.db · SQLite\nprocedimiento · propietario\natencion · atencion_linea", fillcolor="#edf2f5"];
  binario [shape=note, label="respaldo.bin\nSerialización / Externalizable\nCatálogo + propietarios + atenciones", fillcolor="#edf2f5"];
  app -> ui [label="arranque"];
  app -> servicio;
  app -> persistencia [style=dashed, label="demo / pruebas"];
  ui -> servicio [label="único acceso a casos de uso"];
  ui -> modelo [label="tipos para presentación", constraint=false];
  servicio -> persistencia;
  servicio -> concurrencia [label="Monitor extiende TareaPeriodica"];
  servicio -> eventos [label="publica / suscribe"];
  servicio -> funcional;
  servicio -> modelo;
  persistencia -> modelo;
  funcional -> modelo [label="Reglas / fábrica"];
  modelo -> funcional [label="Catálogo usa Regla<T>", constraint=false];
  persistencia -> sqlite [label="JDBC · transacciones", style=dashed];
  persistencia -> binario [label="serialización", style=dashed];
  { rank=same; funcional; modelo; }
  nota [shape=note, fillcolor="#fff8dd", fontsize=10, label="Flecha continua: dependencia de código (vista resumida).\nDiscontinua: arranque auxiliar o acceso a almacenamiento.\nEl acoplamiento modelo ↔ funcional ya existe en el esqueleto.\nLa UI no importa persistencia ni ejecuta SQL."];
}
