@startuml
title Modelo de objetos: clases y relaciones actuales (05/11/2026)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members
left to right direction

package modelo {
  interface "Facturable" as Facturable <<interface>> {
    +TASA_IMPUESTO : double = 0.16
    --
    +clave() : CodigoClinico
    +nombre() : String
    +precioBase() : double
    +tarifa(u:int) : double
    +tarifaConImpuesto(u:int) : double
    {static} +porNombre() : Comparator
  }
  interface "Programable" as Programable <<interface>> {
    +intervaloDias() : int
    +descripcionCorta() : String
  }
  interface "Supervisado" as Supervisado <<interface>> {
    +responsable() : String
    +descripcionCorta() : String
  }
  abstract class "Procedimiento" as Procedimiento <<abstract sealed>> {
    -clave : CodigoClinico
    -nombre : String
    -precioBase : double
    -creadoEn : LocalDateTime
    -cotizaciones : int {transient}
    --
    +tarifa(unidades:int) : double {final}
    #calcularTarifa(unidades:int) : double {abstract}
    +copiar() : Procedimiento {abstract}
    +setNombre(nombre:String)
    +setPrecioBase(precio:double)
    +tipo() : String
  }
  class "Procedimiento.Vacuna" as Vacuna <<final static>> {
    +PREFIJO : String = VAC
    -biologico : String
    --
    #calcularTarifa(u:int) : double
    +copiar() : Vacuna
    +intervaloDias() : int
  }
  class "Procedimiento.Consulta" as Consulta <<final static>> {
    +PREFIJO : String = CON
    -prioridad : int
    --
    #calcularTarifa(u:int) : double
    +copiar() : Consulta
    +responsable() : String
  }
  class "Procedimiento.Cirugia" as Cirugia <<final static>> {
    +PREFIJO : String = CIR
    -horasQuirofano : int
    --
    #calcularTarifa(u:int) : double
    +copiar() : Cirugia
    +descripcionCorta() : String
  }
  class "CodigoClinico" as CodigoClinico <<record>> {
    prefijo : String
    numero : int
    --
    {static} +siguiente(prefijo:String) : CodigoClinico
    {static} +registrar(clave:CodigoClinico)
    {static} +parse(texto:String) : CodigoClinico
  }
  enum "Nivel" as Nivel <<enum>> {
    GENERAL (0%)
    PLAN_SALUD (12%)
    RESCATISTA (30%)
    --
    +descuento() : double
    +aplicar(monto:double) : double
  }
  enum "Estado" as Estado <<enum>> {
    ABIERTA
    EN_CURSO
    CERRADA
    CANCELADA
    --
    +permiteTransicionA(destino:Estado) : boolean
    +esTerminal() : boolean
  }
  class "Propietario" as Propietario <<Externalizable>> {
    -id : int
    -nombre : String
    -correo : String
    -nivel : Nivel
    --
    +setNombre(nombre:String)
    +setCorreo(correo:String)
    +setNivel(nivel:Nivel)
    +writeExternal(out:ObjectOutput)
    +readExternal(in:ObjectInput)
  }
  class "Atencion" as Atencion <<Serializable / Iterable>> {
    -id : int
    -propietario : Propietario
    -fecha : LocalDate
    -estado : Estado
    -lineas : ArrayList<Linea>
    --
    +agregar(elemento:Procedimiento,u:int) : Linea
    +quitar(clave:CodigoClinico) : boolean
    +cambiarEstado(destino:Estado)
    +lineas() : List<Linea>
    +subtotal() : double
    +total() : double
    +diasDesde(hoy:LocalDate) : long
  }
  class "Atencion.Linea" as Linea <<inner final>> {
    -elemento : Procedimiento
    -unidades : int
    --
    +subtotal() : double
    +importe() : double
    +contenedor() : Atencion
  }
  class "CatalogoProcedimientos" as Catalogo <<Iterable>> {
    -elementos : LinkedHashMap
    --
    +agregar(e:Procedimiento...)
    +buscar(clave:CodigoClinico) : Optional
    +filtrar(regla:Regla) : List
    +deTipo(tipo:Class) : List
    {static} +porTarifa(u:int) : Comparator
    +resumen() : String
  }
  class "CatalogoProcedimientos.Iterador" as Iterador <<private inner>> {
    +hasNext() : boolean
    +next() : Procedimiento
  }
  class "ReglaNegocioException" as ReglaEx <<RuntimeException>> {
  }
}

package funcional {
  interface "Regla<T>" as Regla <<functional interface>> {
    +evaluar(t:T) : boolean
    +y(otra:Regla) : Regla
    +o(otra:Regla) : Regla
    +negar() : Regla
    +comoPredicado() : Predicate
  }
  class "Reglas" as Reglas <<utility>> {
    {static} +precioHasta(max:double) : Regla
    {static} +nombreContiene(texto:String) : Regla
    {static} +conCapacidad(tipo:Class) : Regla
  }
  interface "FabricaElemento<E, A>" as Fabrica <<functional interface>> {
    +crear(nombre:String, precio:double, atributo:A) : E
  }
}

Procedimiento ..|> Facturable
Vacuna --|> Procedimiento
Consulta --|> Procedimiento
Cirugia --|> Procedimiento
Vacuna ..|> Programable
Consulta ..|> Supervisado
Cirugia ..|> Programable
Cirugia ..|> Supervisado
Procedimiento --> CodigoClinico : clave
Facturable ..> CodigoClinico : tipo de retorno
Propietario --> Nivel : nivel
Atencion --> Propietario : propietario 1
Atencion --> Estado : estado
Atencion *--> Linea : 0..* líneas
Linea --> Procedimiento : elemento 1
Catalogo o--> Procedimiento : 0..* elementos
Catalogo *--> Iterador : clase interna
Catalogo ..> Regla : filtrar
Reglas ..> Regla : produce
Reglas ..> Procedimiento : filtros
Fabrica ..> Procedimiento : E acotado

@enduml
